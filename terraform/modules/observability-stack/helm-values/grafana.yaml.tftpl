# ==============================================================================
# Grafana
#
# Datasource URLs must match the services the other charts actually create:
#   Loki  -> `loki:3100`         (the chart's nginx gateway is disabled)
#   Mimir -> `mimir-gateway`     (injects X-Scope-OrgID: anonymous)
#   Tempo -> `tempo:3200`        (HTTP query API; 4317 is OTLP ingest)
#
# The admin password is generated by the chart into the `grafana` Secret.
# Retrieve it with `make grafana-password`.
# ==============================================================================

replicas: 1

resources:
  requests:
    cpu: 50m
    memory: 192Mi
  limits:
    memory: 384Mi

persistence:
  enabled: false

# Picks up any ConfigMap in the namespace labelled `grafana_dashboard: "1"`.
# The sidecar writes its own dashboard provider file, so the repo must NOT ship
# a provider ConfigMap carrying that label — it would be dropped into the
# dashboard directory and fail to parse as a dashboard.
sidecar:
  dashboards:
    enabled: true
    label: grafana_dashboard
    labelValue: "1"
    folder: /tmp/dashboards
    searchNamespace: monitoring
  datasources:
    enabled: false

%{ if use_amp ~}
grafana.ini:
  auth.sigv4:
    sigv4_auth_enabled: true
%{ endif ~}

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
%{ if use_amp ~}
      - name: Amazon Managed Prometheus (AMP)
        type: prometheus
        uid: prometheus
        access: proxy
        url: ${amp_workspace_endpoint}
        isDefault: true
        jsonData:
          httpMethod: POST
          sigV4Auth: true
          sigV4AuthType: default
          sigV4Region: ${aws_region}
          timeInterval: 15s
%{ else ~}
      - name: Mimir (Prometheus)
        type: prometheus
        uid: prometheus
        access: proxy
        url: http://mimir-gateway.monitoring.svc.cluster.local/prometheus
        isDefault: true
        jsonData:
          httpMethod: POST
          timeInterval: 15s
%{ endif ~}

      - name: Loki
        type: loki
        uid: loki
        access: proxy
        url: http://loki.monitoring.svc.cluster.local:3100
        jsonData:
          # Turns the trace_id printed in application logs into a clickable
          # link through to the Tempo trace view.
          derivedFields:
            - name: TraceID
              matcherRegex: "trace_id=([a-f0-9]+)"
              url: "$${__value.raw}"
              datasourceUid: tempo

      - name: Tempo
        type: tempo
        uid: tempo
        access: proxy
        url: http://tempo.monitoring.svc.cluster.local:3200
        jsonData:
          tracesToLogsV2:
            datasourceUid: loki
            spanStartTimeShift: "-1m"
            spanEndTimeShift: "1m"
            filterByTraceID: true
            filterBySpanID: false
            customQuery: true
            query: '{$${__tags}} |= "$${__trace.traceId}"'
            tags:
              - key: service.name
                value: service_name
          tracesToMetrics:
            datasourceUid: prometheus
            spanStartTimeShift: "-1m"
            spanEndTimeShift: "1m"
          nodeGraph:
            enabled: true
