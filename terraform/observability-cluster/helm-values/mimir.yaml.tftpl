# ==============================================================================
# Mimir — mimir-distributed, scaled down to one replica per component
#
# Two chart-6.x defaults have to be switched off explicitly, and they are the
# difference between "works" and "silently drops every write":
#
# 1. `kafka.enabled: true` — Mimir 3.x defaults to the ingest-storage
#    architecture and ships a bundled Kafka StatefulSet requesting a full CPU
#    and 1Gi of memory.
#
# 2. `ingest_storage.enabled: true` is hardcoded in the chart's base config, and
#    it also hardcodes `ingester.push_grpc_method_enabled: false` — because in
#    that architecture writes are expected to arrive via Kafka. Turning Kafka
#    off WITHOUT re-enabling the gRPC push method leaves the distributor with no
#    way to reach the ingester, and every remote-write returns 500.
#
# Both overrides are applied under `mimir.structuredConfig` below.
#
# Write endpoint: http://mimir-gateway.monitoring.svc.cluster.local/api/v1/push
# Query endpoint: http://mimir-gateway.monitoring.svc.cluster.local/prometheus
#
# The gateway injects `X-Scope-OrgID: anonymous`, so neither Grafana nor the
# OTel gateway needs to set a tenant header.
#
# 3. Ruler storage is `local`, not `s3`, unlike every other Mimir component
#    here. Mimir's `s3` ruler backend only accepts rule groups pushed through
#    the ruler's HTTP config API (mimirtool) — there is no "drop a YAML file
#    in S3" path — which would mean rule changes bypass `git`/`kubectl apply`
#    entirely. `local` reads rule groups straight from a mounted ConfigMap
#    (see `ruler.extraVolumes` below and
#    observability-platform/k8s-manifests/mimir-ruler-rules-configmap.yaml),
#    keeping SLO rules declarative like everything else in this repo. The
#    trade-off: local storage is read-only, so the config API can't create or
#    delete rules at runtime — irrelevant here since nothing calls that API.
#    `ruler.alertmanager_url` needs no override: the chart's own default
#    (`dnssrvnoa+http://..._http-metrics._tcp.mimir-alertmanager-headless...`)
#    already resolves once `alertmanager.enabled: true` creates that headless
#    Service, so the ruler finds the alertmanager below for free.
# ==============================================================================

# --- Components we do not run in the demo -------------------------------------
kafka:
  enabled: false
rollout_operator:
  enabled: false
overrides_exporter:
  enabled: false
minio:
  enabled: false

# Memcached tiers — each would add a pod with a multi-GB memory request.
chunks-cache:
  enabled: false
index-cache:
  enabled: false
metadata-cache:
  enabled: false
results-cache:
  enabled: false

mimir:
  structuredConfig:
    # See note (2) above — these two must move together.
    ingest_storage:
      enabled: false
    ingester:
      push_grpc_method_enabled: true
      ring:
        replication_factor: 1

    blocks_storage:
      backend: s3
      s3:
        bucket_name: ${mimir_blocks_bucket}
        endpoint: s3.${aws_region}.amazonaws.com
        region: ${aws_region}

    # See note (3) above — rule groups come from the ConfigMap mounted at
    # ruler.extraVolumeMounts below, one file per tenant directory. The
    # gateway's anonymous org means the tenant directory is literally
    # "anonymous" — get that path wrong and the ruler starts clean with zero
    # loaded rules, no error, nothing firing.
    ruler_storage:
      backend: local
      local:
        directory: /var/mimir-ruler-rules

    alertmanager_storage:
      backend: s3
      s3:
        bucket_name: ${mimir_alertmanager_bucket}
        endpoint: s3.${aws_region}.amazonaws.com
        region: ${aws_region}

    limits:
      compactor_blocks_retention_period: 168h

# --- Single-replica topology --------------------------------------------------
distributor:
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 192Mi }
    limits: { memory: 384Mi }

ingester:
  replicas: 1
  # Zone-aware replication creates one StatefulSet per zone (3x the pods) and
  # requires 3 ingesters for write quorum.
  zoneAwareReplication:
    enabled: false
  persistentVolume:
    size: 10Gi
    storageClass: gp3
  resources:
    requests: { cpu: 100m, memory: 512Mi }
    limits: { memory: 1Gi }

querier:
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 192Mi }
    limits: { memory: 384Mi }

query_frontend:
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 256Mi }

query_scheduler:
  replicas: 1
  resources:
    requests: { cpu: 25m, memory: 128Mi }
    limits: { memory: 256Mi }

store_gateway:
  replicas: 1
  zoneAwareReplication:
    enabled: false
  persistentVolume:
    size: 10Gi
    storageClass: gp3
  resources:
    requests: { cpu: 50m, memory: 256Mi }
    limits: { memory: 512Mi }

compactor:
  replicas: 1
  persistentVolume:
    size: 10Gi
    storageClass: gp3
  resources:
    requests: { cpu: 50m, memory: 256Mi }
    limits: { memory: 512Mi }

gateway:
  replicas: 1
  resources:
    requests: { cpu: 25m, memory: 64Mi }
    limits: { memory: 128Mi }

ruler:
  enabled: true
  replicas: 1
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 256Mi }
  # Mounts observability-platform/k8s-manifests/mimir-ruler-rules-configmap.yaml
  # at the local ruler_storage directory, under the anonymous tenant. Every key
  # in that ConfigMap becomes one file — one Mimir ruler "namespace" — inside
  # /var/mimir-ruler-rules/anonymous/.
  extraVolumes:
    - name: ruler-rules
      configMap:
        name: mimir-ruler-rules
  extraVolumeMounts:
    - name: ruler-rules
      mountPath: /var/mimir-ruler-rules/anonymous

alertmanager:
  enabled: true
  replicas: 1
  resources:
    requests: { cpu: 10m, memory: 32Mi }
    limits: { memory: 128Mi }
  persistentVolume:
    size: 1Gi
    storageClass: gp3
  # Unlike ruler_storage, alertmanager_storage is still S3 (see above) — it
  # holds per-tenant runtime state (silences, notification log), not config.
  # fallbackConfig below is what actually applies, because this demo never
  # pushes a per-tenant config through Mimir's Alertmanager config API; it is
  # the config every tenant here runs.
  #
  # Routes by the `severity` label the burn-rate alerts carry: `page` goes to
  # GoAlert (observability-platform/k8s-manifests/goalert.yaml) — a real
  # escalation policy, not a webhook echo — because a fast/medium burn-rate
  # breach is exactly what an on-call rotation exists for. `ticket` stays on
  # `alert-sink`, since a slow-burn SLO warning genuinely doesn't need to page
  # anyone; it needs to be visible, which `kubectl logs -l app=alert-sink`
  # already gives it.
  #
  # `<GOALERT_INTEGRATION_KEY>` is not a Terraform variable — GoAlert
  # generates it interactively (Setup Wizard -> Generic API integration),
  # there is no declarative way to pre-create it. See the bootstrap steps at
  # the bottom of goalert.yaml. Until that placeholder is replaced, `page`
  # alerts will fail to deliver (GoAlert returns 401 for an unknown token)
  # rather than silently vanish — check GoAlert's own request log if a page
  # doesn't show up after that step.
  fallbackConfig: |
    route:
      receiver: alert-sink
      group_by: ['alertname', 'service']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      routes:
        - matchers:
            - severity="page"
          receiver: goalert
          group_wait: 10s
          repeat_interval: 1h
        - matchers:
            - severity="ticket"
          receiver: alert-sink
          repeat_interval: 12h
    receivers:
      - name: alert-sink
        webhook_configs:
          - url: http://alert-sink.monitoring.svc.cluster.local:8080/webhook
            send_resolved: true
      - name: goalert
        webhook_configs:
          - url: "http://goalert.monitoring.svc.cluster.local:8081/api/v2/generic/incoming?token=<GOALERT_INTEGRATION_KEY>"
            send_resolved: true
